# ==============================================================================
# Samabox — Environment Configuration Template
# DO NOT COMMIT SECRETS OR REAL API KEYS TO VERSION CONTROL.
# Copy this file to .env for local configuration if required.
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Settings (defaults to data/samabox.db)
DB_PATH=./data/samabox.db

# LLM Security Intelligence Provider (Optional)
# If LLM_API_KEY is omitted or blank, Samabox automatically and gracefully
# activates the local deterministic heuristic SecOps analysis engine.
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
